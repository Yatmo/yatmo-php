{
    "name": "yatmo/yatmo-php",
    "description": "Real estate maps, points of interest and neighbourhood data for PHP: typed client for the Yatmo API (neighbourhood text for SEO, nearest schools, shops and public transport with travel times, scores, isochrones, routes, geocoding, static maps). Laravel, Symfony, WordPress, plain PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": ["yatmo", "real-estate", "proptech", "map", "poi", "points-of-interest", "neighbourhood", "property", "listing", "isochrone", "geocoding", "seo", "laravel", "symfony"],
    "homepage": "https://documentation.yatmo.com/api",
    "support": {
        "docs": "https://documentation.yatmo.com/api",
        "issues": "https://github.com/Yatmo/yatmo-php/issues",
        "source": "https://github.com/Yatmo/yatmo-php"
    },
    "authors": [
        { "name": "Yatmo", "email": "support@yatmo.com", "homepage": "https://yatmo.com" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-curl": "Used by the default transport; any PSR-18 client can replace it through Yatmo\\Transport\\TransportInterface"
    },
    "autoload": {
        "classmap": ["src/"]
    },
    "autoload-dev": {
        "classmap": ["tests/"]
    },
    "scripts": {
        "test": "phpunit --exclude-group live",
        "test:live": "phpunit --group live"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
